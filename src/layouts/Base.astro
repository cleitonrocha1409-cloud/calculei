---
import "../styles/global.css";
import { SITE } from "../config";
import { CATEGORIAS } from "../data/catalogo";

interface Props {
  titulo: string;
  descricao?: string;
  jsonld?: object[];
}
const { titulo, descricao = SITE.descricao, jsonld = [] } = Astro.props;
const canonica = new URL(Astro.url.pathname, SITE.dominio).href;
const tituloCompleto = Astro.url.pathname === "/" ? `${SITE.nome}: calculadoras do dia a dia` : `${titulo} | ${SITE.nome}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="theme-color" content="#1f3b7a" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%231f3b7a'/><text x='16' y='23' font-size='19' text-anchor='middle' fill='%23ffe27a' font-family='sans-serif' font-weight='700'>=</text></svg>" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <header class="topo">
      <div class="envelope topo__linha">
        <a class="marca" href="/">{SITE.nome}<span aria-hidden="true">=</span></a>
        <nav aria-label="Categorias">
          <ul>
            {CATEGORIAS.map((c) => <li><a href={`/${c.slug}/`}>{c.nome}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="rodape">
      <div class="envelope rodape__grade">
        <div>
          <p class="marca marca--rodape">{SITE.nome}<span aria-hidden="true">=</span></p>
          <p>Resultados são simulações e não substituem a orientação de um contador ou advogado.</p>
        </div>
        <ul>
          <li><a href="/sobre/">Quem somos e metodologia</a></li>
          <li><a href="/privacidade/">Política de privacidade</a></li>
          <li><a href="/termos/">Termos de uso</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .pular {
    position: absolute;
    left: -999px;
  }
  .pular:focus {
    left: 1rem;
    top: 1rem;
    background: var(--papel);
    padding: 0.5rem 1rem;
    z-index: 10;
  }
  .topo {
    background: var(--carteira);
    color: #fff;
  }
  .topo__linha {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 64px;
  }
  .marca {
    font: 700 1.45rem/1 var(--titulo);
    color: #fff;
    text-decoration: none;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .marca span {
    color: var(--marca-texto);
    margin-left: 2px;
  }
  .topo nav {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .topo nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }
  .topo nav a {
    color: #dfe6f5;
    text-decoration: none;
    font-size: 0.94rem;
  }
  .topo nav a:hover {
    color: #fff;
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .topo__linha {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
      padding: 0.9rem 0 0.7rem;
    }
    .topo nav {
      width: 100%;
    }
  }
  .rodape {
    margin-top: 5rem;
    border-top: 1px solid var(--linha);
    background: var(--papel);
    padding: 2.5rem 0 3rem;
    font-size: 0.92rem;
    color: var(--tinta-2);
  }
  .rodape__grade {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
  }
  .rodape ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .marca--rodape {
    color: var(--carteira);
    margin-bottom: 0.6rem;
  }
  .marca--rodape span {
    color: var(--carteira);
  }
  @media (max-width: 720px) {
    .rodape__grade {
      grid-template-columns: 1fr;
    }
  }
</style>
