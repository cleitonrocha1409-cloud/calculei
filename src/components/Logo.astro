---
// Logo do Cálculo em Dia: folha de calendário com o visto sobre o marca-texto + nome.
// "claro" = sobre o azul do topo (folha branca); "escuro" = sobre fundo claro (selo azul).
interface Props {
  variante?: "claro" | "escuro";
}
const { variante = "claro" } = Astro.props;
---

<span class={`logo logo--${variante}`}>
  {
    variante === "claro" ? (
      <svg class="logo__simbolo" viewBox="4 3 36 37" aria-hidden="true">
        <rect x="5" y="8" width="34" height="31" rx="7" fill="#fff" />
        <rect x="13" y="4" width="4" height="9" rx="2" fill="#ffe27a" />
        <rect x="27" y="4" width="4" height="9" rx="2" fill="#ffe27a" />
        <path d="M10 27.5 34 22.5 35 30 11 34.5z" fill="#ffe27a" />
        <path d="M14 25.5l5.5 5.5L31 19" fill="none" stroke="#1f3b7a" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    ) : (
      <svg class="logo__simbolo" viewBox="0 0 44 44" aria-hidden="true">
        <rect width="44" height="44" rx="10" fill="#1f3b7a" />
        <rect x="7" y="10" width="30" height="27" rx="6" fill="#fff" />
        <rect x="14" y="6" width="4" height="8" rx="2" fill="#ffe27a" />
        <rect x="26" y="6" width="4" height="8" rx="2" fill="#ffe27a" />
        <path d="M11 27 33 22.5 34 29.5 12 33.5z" fill="#ffe27a" />
        <path d="M15 25.5l5 5L30 20" fill="none" stroke="#1f3b7a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  <span class="logo__nome">Cálculo<span class="logo__destaque">em Dia</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font: 700 1em/1 var(--titulo);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .logo__simbolo {
    width: 1.3em;
    height: 1.3em;
    flex: none;
  }
  .logo--claro {
    color: #fff;
  }
  .logo--escuro {
    color: var(--carteira);
  }
  .logo__destaque {
    position: relative;
    z-index: 0;
    display: inline-block;
    margin-left: 0.2em;
    padding: 0 0.14em;
    color: var(--carteira);
  }
  .logo__destaque::before {
    content: "";
    position: absolute;
    inset: 0.12em -0.02em 0.02em -0.04em;
    background: var(--marca-texto);
    border-radius: 0.12em 0.3em 0.14em 0.28em;
    transform: skew(-8deg) rotate(-2deg);
    z-index: -1;
  }
</style>
