---
import Base from "../layouts/Base.astro";
import "../styles/calculadora.css";
import { SITE } from "../config";
import { CATEGORIAS } from "../data/catalogo";
import Selo from "./Selo.astro";

interface Props {
  titulo: string; // <title>
  descricao: string;
  h1: string;
  apoio?: string;
  selo?: string; // regras legais conferidas, ex.: "Tabelas do INSS e do IR de 2026"
  categoria: string; // slug
  caminho: string; // ex.: /trabalhista/salario-liquido/
  nomeApp: string;
  perguntas: { p: string; r: string }[];
}
const { selo, titulo, descricao, h1, apoio = "Preencha os dados. O resultado aparece ao lado e se atualiza enquanto você digita.", categoria, caminho, nomeApp, perguntas } = Astro.props;
const cat = CATEGORIAS.find((c) => c.slug === categoria)!;
const relacionadas = cat.calculadoras.filter((c) => c.url && c.url !== caminho);

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: nomeApp,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Web",
    offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
    url: SITE.dominio + caminho,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: perguntas.map((q) => ({ "@type": "Question", name: q.p, acceptedAnswer: { "@type": "Answer", text: q.r } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: SITE.dominio + "/" },
      { "@type": "ListItem", position: 2, name: cat.nome, item: `${SITE.dominio}/${cat.slug}/` },
      { "@type": "ListItem", position: 3, name: h1 },
    ],
  },
];
---

<Base titulo={titulo} descricao={descricao} jsonld={jsonld}>
  <div class="envelope cabecalho">
    <p class="trilha"><a href="/">Início</a> / <a href={`/${cat.slug}/`}>{cat.nome}</a> / {h1}</p>
    <h1>{h1}</h1>
    <p class="cabecalho__apoio">{apoio}</p>
    {selo && <Selo regras={selo} />}
  </div>

  <div class="envelope calc">
    <form id="form" class="form" novalidate>
      <slot name="form" />
    </form>
    <section class="resultado" id="resultado" aria-live="polite" aria-label="Resultado">
      <div class="holerite" id="holerite"><p class="vazio">Preencha os dados para ver o cálculo.</p></div>
      <div class="acoes" id="acoes" hidden>
        <button type="button" id="pdf">Baixar PDF</button>
        <a id="whats" target="_blank" rel="noopener">Enviar no WhatsApp</a>
        <button type="button" id="copiar">Copiar link</button>
      </div>
    </section>
  </div>

  <div class="barra" id="barra" hidden>
    <span><span id="barra-rotulo">Você recebe</span> <strong id="barra-valor"></strong></span>
    <a href="#resultado">Ver detalhes</a>
  </div>

  <slot name="depois" />

  <article class="envelope conteudo texto-longo">
    <slot name="conteudo" />
    <h2>Perguntas frequentes</h2>
    {
      perguntas.map((q) => (
        <details class="faq">
          <summary>{q.p}</summary>
          <p>{q.r}</p>
        </details>
      ))
    }
    {
      relacionadas.length > 0 && (
        <>
          <h2>Outras calculadoras</h2>
          <ul class="relacionadas">
            {relacionadas.map((c) => (
              <li>
                <a href={c.url}>{c.titulo}</a>: {c.resumo.toLowerCase()}
              </li>
            ))}
          </ul>
        </>
      )
    }
  </article>
</Base>
