---
// Convite para a lista de espera do Cálculo em Dia Empresas, abaixo da prévia dos geradores.
// Passo 1: só o e-mail. Passo 2 (opcional): conte sobre o negócio.
import Icone from "../Icone.astro";
const interesses = [
  ["holerite", "Holerite todo mês"],
  ["ferias-13", "Férias e 13º"],
  ["escalas", "Escalas"],
  ["ponto", "Ponto pelo celular"],
  ["rescisao", "Rescisão"],
  ["contador", "Envio ao contador"],
];
---

<aside class="lista" id="lista-espera" aria-labelledby="lista-titulo">
  <p class="lista__selo"><Icone nome="aviso" tamanho={18} /> Em breve</p>
  <h2 id="lista-titulo">Cálculo em Dia Empresas</h2>
  <ul class="lista__itens">
    <li><Icone nome="pessoas" /> Funcionários salvos, com histórico</li>
    <li><Icone nome="holerite" /> Holerites, férias e 13º do mês em um clique</li>
    <li><Icone nome="escala" /> Escalas e ponto da equipe</li>
  </ul>

  <form class="lista__form" id="lista-form" novalidate>
    <label for="le-email" class="lista__rotulo">Seja avisado primeiro</label>
    <div class="lista__linha">
      <input id="le-email" type="email" autocomplete="email" maxlength="120" placeholder="seu@email.com" />
      <button type="submit" class="lista__enviar" id="le-enviar">Avisar</button>
    </div>
    <input class="lista__mel" name="site" id="le-site" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label class="marcar lista__consent">
      <input type="checkbox" id="le-consent" />
      <span>Autorizo o aviso de lançamento por e-mail. Posso <a href="/lista-de-espera/sair/">sair da lista</a> quando quiser.</span>
    </label>
    <p class="lista__erro" id="le-erro" role="alert" hidden></p>
  </form>

  <div class="lista__ok" id="lista-ok" hidden role="status">
    <p><strong>Pronto, você está na lista.</strong> Avisaremos quando a versão para empresas abrir.</p>
    <div class="porte" id="le-porte" hidden></div>
    <button type="button" class="lista__mais" id="lista-mais" aria-expanded="false" aria-controls="lista-detalhes">Conte mais sobre o seu negócio (opcional)</button>
  </div>

  <form class="lista__form" id="lista-detalhes" hidden novalidate>
    <div class="campo"><label for="ld-nome">Nome</label><input id="ld-nome" autocomplete="name" maxlength="90" /></div>
    <div class="campo"><label for="ld-whats">WhatsApp</label><input id="ld-whats" type="tel" inputmode="tel" autocomplete="tel" maxlength="16" placeholder="(11) 90000-0000" /></div>
    <fieldset class="lista__grupo">
      <legend>Você é</legend>
      <label><input type="radio" name="ld-perfil" value="dono" /> Dono ou gestor do negócio</label>
      <label><input type="radio" name="ld-perfil" value="contador" /> Contador</label>
      <label><input type="radio" name="ld-perfil" value="outro" /> Outro</label>
    </fieldset>
    <fieldset class="lista__grupo">
      <legend>O que mais faria diferença</legend>
      <div class="chips">
        {interesses.map(([v, t]) => <label class="chip"><input type="checkbox" name="ld-int" value={v} /><span>{t}</span></label>)}
      </div>
    </fieldset>
    <p class="lista__erro" id="ld-erro" role="alert" hidden></p>
    <button type="submit" class="lista__enviar lista__enviar--largo" id="ld-enviar">Enviar</button>
  </form>
  <p class="lista__ok" id="lista-obrigado" hidden role="status"><strong>Obrigado!</strong> Isso nos ajuda a priorizar o que fazer primeiro.</p>
</aside>

<script>
  import { emailInscrito, inscrever, jaInscrito, perguntarPorte } from "../../lib/ui/lista-espera";
  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>("lista-form");
  const detalhes = $<HTMLFormElement>("lista-detalhes");

  function mostrarInscrito() {
    form.hidden = true;
    $("lista-ok").hidden = false;
    perguntarPorte($("le-porte"));
  }
  if (jaInscrito()) mostrarInscrito();
  document.addEventListener("lista-espera:inscrito", mostrarInscrito);

  $("lista-mais").addEventListener("click", () => {
    detalhes.hidden = false;
    $("lista-mais").hidden = true;
    $("ld-nome").focus();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const erro = $("le-erro");
    const botao = $<HTMLButtonElement>("le-enviar");
    erro.hidden = true;
    botao.disabled = true;
    try {
      await inscrever({ email: $("le-email").value, consentimento: $("le-consent").checked, site: $("le-site").value }, "convite-gerador");
    } catch (err) {
      erro.textContent = (err as Error).message;
      erro.hidden = false;
    } finally {
      botao.disabled = false;
    }
  });

  detalhes.addEventListener("submit", async (e) => {
    e.preventDefault();
    const erro = $("ld-erro");
    const botao = $<HTMLButtonElement>("ld-enviar");
    erro.hidden = true;
    botao.disabled = true;
    try {
      await inscrever(
        {
          email: emailInscrito(),
          consentimento: true,
          nome: $("ld-nome").value,
          whatsapp: $("ld-whats").value,
          perfil: (document.querySelector('input[name="ld-perfil"]:checked') as HTMLInputElement | null)?.value,
          interesses: [...document.querySelectorAll<HTMLInputElement>('input[name="ld-int"]:checked')].map((c) => c.value),
        },
        "detalhes",
      );
      detalhes.hidden = true;
      $("lista-ok").hidden = true;
      $("lista-obrigado").hidden = false;
    } catch (err) {
      erro.textContent = (err as Error).message;
      erro.hidden = false;
    } finally {
      botao.disabled = false;
    }
  });
</script>

<style>
  .lista {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--raio);
    background: #fff;
    border: 1.5px solid var(--carteira);
  }
  .lista [hidden] {
    display: none !important;
  }
  .lista h2 {
    font: 700 1.2rem var(--titulo);
    margin: 0 0 0.6rem;
  }
  .lista__selo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 0.4rem;
    padding: 0.15rem 0.6rem 0.15rem 0.45rem;
    border-radius: 999px;
    background: var(--marca-texto);
    font-size: 0.82rem;
    font-weight: 700;
  }
  .lista__itens {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .lista__itens li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .lista__itens :global(svg) {
    flex: none;
    color: var(--carteira);
    background: var(--carteira-claro);
    border-radius: 8px;
    padding: 6px;
    width: 36px;
    height: 36px;
  }
  .lista__rotulo {
    display: block;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .lista__linha {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
  }
  .lista__linha input {
    min-width: 0;
  }
  .lista__enviar,
  .lista__mais {
    border: 0;
    border-radius: 8px;
    padding: 0.75rem 1.1rem;
    background: var(--carteira);
    color: #fff;
    font: 600 1rem var(--texto);
    cursor: pointer;
  }
  .lista__enviar--largo {
    width: 100%;
  }
  .lista__mais {
    background: none;
    color: var(--carteira);
    padding: 0.3rem 0;
    text-decoration: underline;
    font-size: 0.95rem;
  }
  .lista__enviar[disabled] {
    opacity: 0.6;
  }
  .lista__form {
    display: grid;
    gap: 0.25rem;
  }
  #lista-detalhes {
    margin-top: 1rem;
  }
  .lista__grupo {
    border: 0;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.35rem;
  }
  .lista__grupo legend {
    font-weight: 600;
    margin-bottom: 0.4rem;
    padding: 0;
  }
  .lista__grupo > label {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .lista__grupo input[type="radio"] {
    width: 1.05rem;
    height: 1.05rem;
    min-height: 0;
    accent-color: var(--carteira);
  }
  .lista .chip span {
    min-width: 0;
    padding: 0 0.7rem;
    height: 2.3rem;
    font-size: 0.88rem;
  }
  .lista__mel {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .lista__consent {
    align-items: flex-start;
    font-size: 0.86rem;
    margin: 0.6rem 0 0.2rem;
  }
  .lista__erro {
    color: var(--negativo);
    font-weight: 600;
    margin: 0.4rem 0 0;
  }
  .lista__ok {
    padding: 0.8rem;
    border-radius: 8px;
    background: #e5f4e4;
  }
  .lista__ok p {
    margin: 0 0 0.3rem;
  }
  @media print {
    .lista {
      display: none !important;
    }
  }
</style>
