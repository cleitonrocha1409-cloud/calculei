---
// Cartão discreto abaixo do resultado das calculadoras trabalhistas, para empregadores.
// Aparece depois que há um resultado e some quando a pessoa entra na lista.
import Icone from "../Icone.astro";
---

<div class="cc" id="convite-calc" hidden>
  <span class="cc__icone"><Icone nome="pessoas" tamanho={22} /></span>
  <div class="cc__corpo">
    <p class="cc__titulo">É empregador?</p>
    <p class="cc__texto">Em breve: funcionários salvos e holerite, férias e 13º do mês em um clique. Seja avisado.</p>
    <form class="cc__form" id="cc-form" novalidate>
      <label for="cc-email" class="cc__oculto">E-mail</label>
      <input id="cc-email" type="email" autocomplete="email" maxlength="120" placeholder="seu@email.com" />
      <button type="submit" id="cc-enviar">Avisar</button>
      <label class="cc__consent"><input type="checkbox" id="cc-consent" /><span>Autorizo o aviso por e-mail. Posso <a href="/lista-de-espera/sair/">sair da lista</a> quando quiser.</span></label>
      <p class="cc__erro" id="cc-erro" role="alert" hidden></p>
    </form>
    <div class="cc__ok" id="cc-ok" role="status" hidden><p><strong>Pronto, você está na lista.</strong></p><div class="porte" id="cc-porte" hidden></div></div>
  </div>
</div>

<script>
  import { inscrever, jaInscrito, perguntarPorte } from "../../lib/ui/lista-espera";
  const caixa = document.getElementById("convite-calc")!;
  const acoes = document.getElementById("acoes");
  const form = document.getElementById("cc-form") as HTMLFormElement;
  let acabouDeInscrever = false;
  const atualizar = () => {
    caixa.hidden = (jaInscrito() && !acabouDeInscrever) || !acoes || acoes.hidden;
  };
  if (acoes) new MutationObserver(atualizar).observe(acoes, { attributes: true, attributeFilter: ["hidden"] });
  atualizar();
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const erro = document.getElementById("cc-erro")!;
    const botao = document.getElementById("cc-enviar") as HTMLButtonElement;
    erro.hidden = true;
    botao.disabled = true;
    try {
      await inscrever(
        { email: (document.getElementById("cc-email") as HTMLInputElement).value, consentimento: (document.getElementById("cc-consent") as HTMLInputElement).checked },
        "calculadora",
      );
      acabouDeInscrever = true;
      form.hidden = true;
      document.getElementById("cc-ok")!.hidden = false;
      perguntarPorte(document.getElementById("cc-porte")!);
    } catch (err) {
      erro.textContent = (err as Error).message;
      erro.hidden = false;
    } finally {
      botao.disabled = false;
    }
  });
</script>

<style>
  .cc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0.9rem;
    border: 1.5px dashed var(--linha);
    border-radius: 10px;
    background: #fff;
  }
  .cc[hidden],
  .cc [hidden] {
    display: none !important;
  }
  .cc__icone {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--carteira-claro);
    color: var(--carteira);
  }
  .cc__titulo {
    font-weight: 700;
    margin: 0;
  }
  .cc__texto {
    margin: 0.15rem 0 0.6rem;
    font-size: 0.92rem;
    color: var(--tinta-2);
  }
  .cc__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.45rem;
  }
  .cc__form input[type="email"] {
    min-width: 0;
    font: inherit;
    padding: 0.6rem 0.7rem;
    border: 1.5px solid var(--linha);
    border-radius: 8px;
  }
  .cc__form button {
    border: 0;
    border-radius: 8px;
    padding: 0.6rem 1rem;
    background: var(--carteira);
    color: #fff;
    font: 600 0.95rem var(--texto);
    cursor: pointer;
  }
  .cc__consent {
    grid-column: 1 / -1;
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
    font-size: 0.82rem;
    color: var(--tinta-2);
  }
  .cc__consent input {
    width: 1rem;
    height: 1rem;
    min-height: 0;
    margin-top: 0.1rem;
  }
  .cc__erro {
    grid-column: 1 / -1;
    color: var(--negativo);
    font-weight: 600;
    margin: 0;
    font-size: 0.9rem;
  }
  .cc__ok p {
    margin: 0;
  }
  .cc__oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media print {
    .cc {
      display: none !important;
    }
  }
</style>
