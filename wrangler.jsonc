{
  // Publicação no Cloudflare Workers: site estático + rota /api/indices.
  "name": "calculei",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-12",
  // Domínio próprio (zona calculoemdia.com.br no Cloudflare). O www é redirecionado para o domínio principal.
  "routes": [
    { "pattern": "calculoemdia.com.br", "custom_domain": true },
    { "pattern": "www.calculoemdia.com.br", "custom_domain": true }
  ],
  // Lista de espera do Cálculo em Dia Empresas (esquema em worker/lista-espera.sql).
  "d1_databases": [{ "binding": "LISTA", "database_name": "calculoemdia-lista", "database_id": "9d7f2b6c-a142-46fe-ab9f-b535ac4ed382" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
